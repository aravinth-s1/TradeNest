generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum ListingType {
  SELL
  RENT
}

enum ListingCategory {
  PRODUCT
  LAND
  VEHICLE
  SPACE
  SERVICE
  OTHER
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum RentUnit {
  HOUR
  DAY
  WEEK
  MONTH
}


model Organization {
  id        String    @id @default(cuid())
  name      String
  domains   String[]  // allowed email domains for auto-join
  inviteCode String?  @unique
  createdAt DateTime  @default(now())
  users     User[]
  listings  Listing[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  name           String
  passwordHash   String
  role           Role         @default(MEMBER)
  emailVerified  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  listings       Listing[]

  @@index([organizationId])
}

model Listing {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  sellerId       String
  seller         User            @relation(fields: [sellerId], references: [id])
  type           ListingType
  category       ListingCategory
  title          String
  description    String
  priceCents     Int
  currency       String          @default("INR")
  rentUnit       RentUnit?       // required when type = RENT
  depositCents   Int?            // informational only; settled outside the app
  location       String?
  contactNote    String?         // how the seller prefers to be reached (phone/email/desk); shown to org members
  photos         String[]
  status         ListingStatus   @default(DRAFT)
  createdAt      DateTime        @default(now())

  @@index([organizationId, status])
}



